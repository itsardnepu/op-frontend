# Local API (npm run dev in backend on port 3000)
VITE_API_URL=http://localhost:3000
# VITE_API_KEY=your_public_key

# Production on Vercel: set BACKEND_API_ORIGIN on the *frontend* project; prebuild writes
# .env.production.local with VITE_API_URL so the app calls your backend directly.
# BACKEND_API_ORIGIN=https://api.onepanchang.com
#
# Or set the built API URL explicitly (must match a URL your backend allows via FRONTEND_PUBLIC_ORIGIN):
# VITE_API_URL=https://api.onepanchang.com
